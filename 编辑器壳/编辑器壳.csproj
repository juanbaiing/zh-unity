<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>中文套式编辑器</AssemblyName>
    <RootNamespace>ZhEditorShell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- 把打包好的单文件页面塞进 exe 里，发布出来就一个文件 -->
  <ItemGroup>
    <EmbeddedResource Include="..\中文编辑器.html" LogicalName="ZhEditorShell.index.html" />
  </ItemGroup>

</Project>
